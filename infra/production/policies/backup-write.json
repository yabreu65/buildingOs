{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectDedicatedBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "buildingos/production/*",
            "postgresql/*",
            "_capability-probes",
            "_capability-probes/*"
          ]
        }
      }
    },
    {
      "Sid": "LocateDedicatedBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET"
    },
    {
      "Sid": "WriteDedicatedBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET/buildingos/production/*",
        "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET/postgresql/*",
        "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET/_capability-probes/*"
      ]
    }
  ]
}
