{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApprovedNonProductionRestoreBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::BUILDINGOS_NONPRODUCTION_RESTORE_BUCKET"
    },
    {
      "Sid": "WriteApprovedNonProductionRestoreBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::BUILDINGOS_NONPRODUCTION_RESTORE_BUCKET/*"
    }
  ]
}
