{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDedicatedBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["buildingos/production/*", "postgresql/*"]}}
    },
    {
      "Sid": "LocateDedicatedBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET"
    },
    {
      "Sid": "ReadDedicatedBackupPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET/buildingos/production/*",
        "arn:aws:s3:::BUILDINGOS_BACKUP_BUCKET/postgresql/*"
      ]
    }
  ]
}
