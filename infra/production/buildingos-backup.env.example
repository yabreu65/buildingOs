# Install as /etc/buildingos/buildingos-backup.env with root:root mode 0600.
SOURCE_ENVIRONMENT=production
EXPECTED_SOURCE_ENVIRONMENT=production
SOURCE_ENDPOINT=https://<internal-minio-endpoint>
SOURCE_ACCESS_KEY=<source-read-access-key>
SOURCE_SECRET_KEY=<source-read-secret-key>
SOURCE_BUCKET=buildingos
BACKUP_ENDPOINT=https://usc1.contabostorage.com
BACKUP_BUCKET=<globally-unique-dedicated-buildingos-backup-bucket>
BACKUP_PREFIX=buildingos/production
BACKUP_WRITE_ACCESS_KEY=<backup-write-access-key>
BACKUP_WRITE_SECRET_KEY=<backup-write-secret-key>
BACKUP_VERIFY_ACCESS_KEY=<verify-read-access-key>
BACKUP_VERIFY_SECRET_KEY=<verify-read-secret-key>
BACKUP_SSE_CAPABILITY_FILE=/etc/buildingos/contabo-sse-s3-capability.json
BACKUP_STATE_DIR=/var/lib/buildingos-backup
POSTGRES_CONTAINER=buildingos-postgres
POSTGRES_DATABASE=buildingos
POSTGRES_USER=buildingos
POSTGRES_BACKUP_ROOT=/opt/pawtech/backups/tmp
POSTGRES_RCLONE_DESTINATION=contabowrite:<dedicated-buildingos-backup-bucket>/postgresql
POSTGRES_VERIFY_RCLONE_DESTINATION=contaboverify:<dedicated-buildingos-backup-bucket>/postgresql
POSTGRES_SSE_MODE=SSE-S3
RCLONE_CONFIG_CONTABOWRITE_TYPE=s3
RCLONE_CONFIG_CONTABOWRITE_PROVIDER=Ceph
RCLONE_CONFIG_CONTABOWRITE_ACCESS_KEY_ID=<backup-write-access-key>
RCLONE_CONFIG_CONTABOWRITE_SECRET_ACCESS_KEY=<backup-write-secret-key>
RCLONE_CONFIG_CONTABOWRITE_ENDPOINT=https://usc1.contabostorage.com
RCLONE_CONFIG_CONTABOVERIFY_TYPE=s3
RCLONE_CONFIG_CONTABOVERIFY_PROVIDER=Ceph
RCLONE_CONFIG_CONTABOVERIFY_ACCESS_KEY_ID=<verify-read-access-key>
RCLONE_CONFIG_CONTABOVERIFY_SECRET_ACCESS_KEY=<verify-read-secret-key>
RCLONE_CONFIG_CONTABOVERIFY_ENDPOINT=https://usc1.contabostorage.com
MAX_BACKUP_AGE_SECONDS=129600
