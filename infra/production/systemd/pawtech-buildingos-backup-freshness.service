[Unit]
Description=Check age of latest successful BuildingOS paired backup
OnFailure=pawtech-buildingos-backup-alert@%n.service

[Service]
Type=oneshot
User=yoryi
Group=yoryi
EnvironmentFile=/etc/buildingos/buildingos-backup.env
WorkingDirectory=/opt/pawtech/apps/buildingos/buildingos-app
ExecStart=/opt/pawtech/apps/buildingos/buildingos-app/scripts/check-production-backup-freshness.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/buildingos-backup
