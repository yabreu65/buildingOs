[Unit]
Description=Recover an interrupted BuildingOS Recovery Point S3 fence
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=pawtech-buildingos-backup-alert@%n.service
ConditionPathIsDirectory=/opt/pawtech/backups/recovery-points

[Service]
Type=oneshot
User=yoryi
Group=yoryi
WorkingDirectory=/opt/pawtech/apps/buildingos/buildingos-app
ExecStart=/opt/pawtech/apps/buildingos/buildingos-app/scripts/recover-interrupted-recovery-point.sh
UMask=0077
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pawtech/backups/recovery-points /var/lib/buildingos-backup

[Install]
WantedBy=multi-user.target
