# Copy this template to /etc/buildingos/object-backup.env outside Git.
# Keep the rclone configuration protected outside the repository.
OBJECT_BACKUP_SOURCE=source-remote:buildingos-production
OBJECT_BACKUP_DESTINATION=backup-remote:buildingos-production-backup
OBJECT_BACKUP_RECEIPT=/var/lib/buildingos-object-backup/object-backup-receipt.json
RCLONE_CONFIG=/etc/buildingos/object-backup-rclone.conf
