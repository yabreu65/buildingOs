# =============================================================================
# BuildingOS - Staging Environment Example
# =============================================================================
# Copy this file to the staging VPS as:
#   /opt/pawtech/env/buildingos-staging.env
# Never commit the real file with secrets.
# =============================================================================

# --- Environment ---
APP_ENV=staging
NODE_ENV=production

# --- Service ports on the VPS host ---
API_PORT=4010
WEB_PORT=4011
POSTGRES_PORT=5434
REDIS_PORT=6381

# --- PostgreSQL ---
POSTGRES_USER=buildingos
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=buildingos_staging_db

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Web / API URLs ---
WEB_ORIGIN=https://buildingos-staging.31-220-98-21.sslip.io
APP_BASE_URL=https://buildingos-staging.31-220-98-21.sslip.io
API_URL=https://buildingos-api-staging.31-220-98-21.sslip.io

# --- JWT / Auth ---
JWT_SECRET=REPLACE_WITH_STAGING_JWT_SECRET_64_CHARS_MINIMUM
JWT_EXPIRES_IN=24h

# --- Storage / External S3 ---
S3_ENDPOINT=https://REPLACE_WITH_STAGING_S3_ENDPOINT
S3_REGION=REPLACE_WITH_STAGING_S3_REGION
S3_ACCESS_KEY=REPLACE_WITH_STAGING_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STAGING_S3_SECRET_KEY
S3_BUCKET=buildingos-staging
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://REPLACE_WITH_STAGING_S3_PUBLIC_BASE_URL

# Required only for the one-time STORAGE_01 cutover after API quiescence and
# MinIO public-network isolation. Leave empty for ordinary staging deployments.
STORAGE_CUTOVER_CONFIRMATION=

# --- Mail / Payments ---
MAIL_PROVIDER=smtp
MAIL_FROM=BuildingOS Staging <no-reply@buildingos.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SALES_TEAM_EMAIL=
INFO_EMAIL=
MAILPIT_UI_PORT=8026
PAYMENT_PROVIDER=none

# --- Assistant / AI ---
AI_PROVIDER=none
AI_OLLAMA_URL=
AI_OLLAMA_MODEL=
AI_CLASSIFIER_MODEL=

# --- Feature flags ---
FEATURE_PORTAL_RESIDENT=true
FEATURE_PAYMENTS_MVP=true

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
