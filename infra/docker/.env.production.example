# Compose/control variables. These identify the reviewed application images and
# the protected runtime environment files used by the production deploy script.
IMAGE_TAG=replace-with-reviewed-40-character-sha
BUILD_REVISION=replace-with-reviewed-40-character-sha
API_ENV_FILE=/opt/pawtech/env/buildingos.env
WEB_ENV_FILE=/opt/pawtech/env/buildingos-web.env

# API runtime storage contract. Values are design-only placeholders.
S3_ENDPOINT=https://usc1.contabostorage.com
S3_REGION=default
S3_ACCESS_KEY=replace-with-production-storage-access-key
S3_SECRET_KEY=replace-with-production-storage-secret-key
S3_BUCKET=buildingos-production
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://buildingos-production.example.invalid
